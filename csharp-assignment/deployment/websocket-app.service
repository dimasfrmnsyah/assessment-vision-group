[Unit]
Description=CSharp WebSocket Echo App
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/csharp-assignment/WebSocketApp
ExecStart=/srv/csharp-assignment/WebSocketApp/WebSocketApp
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5101
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
